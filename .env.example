DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Copy .env.example to .env and fill these in. Never commit .env.
#
# The assistant works with all of this left BLANK: it answers from the local database and the
# indexed polycopiés, and tries the anonymous no-key endpoint in between. Nothing here is required
# to run the site.
#
# One key per provider. Each key is sent only to the host that issued it, and each provider has
# its own slugs in backend/aichat/views.py — a slug valid at NVIDIA is a 404 at Google, so
# there is no shared model setting to get wrong. Providers are tried in that order: Gemini,
# NVIDIA, OpenRouter, then OpenAI. The last one is the only entry that bills per token, so it
# answers only when a free lane could not, and leaving its key blank costs you nothing.
#
# The app recognises a key by the form the provider issues it in — paste the whole token, with its
# prefix, no space around it:
#
#   GEMINI_API_KEY      « AIza… »  (long-standing)  ou  « AQ.… »  (ce que AI Studio donne aujourd'hui)
#   NVIDIA_API_KEY      « nvapi-… »
#   OPENROUTER_API_KEY  « sk-or-… »  (les clés v1 sont « sk-or-v1- » suivi de 40 caractères hex)
#   OPENAI_API_KEY      « sk-proj-… », « sk-svcacct-… » ou un ancien « sk-… »
#
# OpenRouter and OpenAI are two different companies: an OpenAI key is not an OpenRouter key and
# neither works in the other's variable. Only OpenRouter's free routes are wired here, so an
# `sk-or-…` token pasted into OPENAI_API_KEY is ignored rather than sent to api.openai.com —
# a key must never reach a host that did not mint it.
#
# A key in the wrong form is not sent anywhere: the provider is skipped and the answer's `note`
# names the expected form, so a mis-paste says so instead of failing as an opaque HTTP 400.
# A blank key also just skips that provider.
#
# Google AI Studio — free, no card: https://aistudio.google.com/api-key
GEMINI_API_KEY=
# NVIDIA — free credits, no card: https://build.nvidia.com
NVIDIA_API_KEY=
# OpenRouter — only "$0 :free" routes are configured; 50 requests/day for the whole account.
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OpenAI — BILLED PER TOKEN, a card is required: https://platform.openai.com/api-keys. Blank here
# means the lane does not exist; a shared sample should not carry a key that can spend money.
OPENAI_API_KEY=

# What the /contact page and the footer publish as the site's own address. The e-mail has a
# default in backend/config/settings.py; the phone is empty here on purpose, so a cloned repo,
# a public release and the shared sample carry no personal number. Set it to show one.
WIKI_CONTACT_EMAIL=
WIKI_CONTACT_PHONE=

# These three lines are the ones to copy for the sample .exe built with -Keyless: put this file
# next to ESI-Wiki.exe (named `.env`) and the launcher picks them up at startup. The other build
# embeds its keys in the binary and needs none.
