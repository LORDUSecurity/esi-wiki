# -*- coding: utf-8 -*-
# Build:  backend-venv/Scripts/python.exe -m PyInstaller packaging/esi-wiki-sample.spec
# Output: dist/ESI-Wiki-Sample/  (that folder is what you share)
#
# onedir, not onefile: a one-file build re-extracts Django to a temp dir on every
# start, which is slower and more often flagged by Windows antivirus.

from pathlib import Path
import os

from PyInstaller.utils.hooks import collect_submodules

REPO = Path(SPECPATH).parent

# Two flavours share this spec (see build-sample.ps1): the sealed build and the keyless one a
# recipient keys themselves. They must not overwrite each other in dist/.
SAMPLE_DIR = os.getenv("WIKI_SAMPLE_DIR", "ESI-Wiki-Sample")

# `build/sample-db/db.sqlite3` is the copy build-sample.ps1 strips of the mirrored EsiHub text:
# the corpus lives in the dev database, and a shared sample must not redistribute several
# megabytes of other people's polycopiés. Building by hand without that step ships the dev DB.
SAMPLE_DB = REPO / "build" / "sample-db" / "db.sqlite3"
DB = SAMPLE_DB if SAMPLE_DB.exists() else REPO / "backend" / "db.sqlite3"

# The provider keys, generated by packaging/keys_embed.py (build-sample.ps1 runs it) into
# packaging/embedded_keys.py, which is gitignored and holds live keys. Compiled INTO the app, so the
# folder the owner hands over configures nothing and carries no key file to notice. Its absence is the
# bring-your-own-key build: the launcher then reads the runner's environment, or a .env beside the .exe.
EMBEDDED_KEYS = REPO / "packaging" / "embedded_keys.py"

# Middleware and DRF pieces are imported by dotted path at runtime, so the static import
# graph never sees them. Without the full subtrees the frozen app dies on first request.
hidden = (
    ["django"]
    + collect_submodules("corsheaders")
    + collect_submodules("rest_framework")
    + collect_submodules("django.db.backends")
    + [
        "django.core.handlers.wsgi",
        "dotenv",
        "waitress",
        "config.settings",
        "config.urls",
        # urlpatterns pull these in by dotted string, so they are invisible to the import graph.
        "catalog.urls",
        "catalog.views",
        "catalog.models",
        "catalog.serializers",
        "catalog.admin",
        "catalog.apps",
        "aichat.urls",
        "aichat.views",
        "aichat.local",
        "core.urls",
        "core.views",
        "core.models",
        "core.serializers",
        "core.admin",
        "core.apps",
    ]
)

# Only when the build embeds keys: without the module the launcher falls back to the runner's own
# environment, which is the bring-your-own-key sample.
if EMBEDDED_KEYS.exists():
    hidden = hidden + ["embedded_keys"]

a = Analysis(
    [str(REPO / "packaging" / "launcher.py")],
    pathex=[str(REPO / "backend"), str(REPO / "packaging")],
    hiddenimports=hidden,
    hookspath=[],
    runtime_hooks=[],
    datas=[
        (str(DB), "."),
        (str(REPO / "frontend" / "dist"), "dist"),
    ],
    excludes=["tkinter", "numpy", "pandas", "matplotlib"],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="ESI-Wiki",
    debug=False,
    strip=False,
    upx=False,
    console=True,  # the window shows the URL and is the only way to stop the server
    icon=None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name=SAMPLE_DIR,
)
