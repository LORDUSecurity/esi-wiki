# Secrets — never committed
.env
*.env.local

# Python
backend-venv/
venv/
__pycache__/
*.py[cod]
backend/db.sqlite3
backend/staticfiles/

# Node
node_modules/
frontend/dist/
tools/node_modules/

# The 33 Commons photos ship with the repo: a clone must render the site, not fetch it first.
# tools/fetch-media.mjs is how they were chosen and pulled; tools/candidates.json keeps the credits.
tools/preview/
tools/montage.jpg

.DS_Store
Thumbs.db
corpus/

# The S1-S2 documents, like the mirror, belong to the school and to the students who assembled
# them. 318 MB of other people's course files do not go in a public repository; the catalogue,
# the code and the tools do. `seed_catalog` and `index_corpus` read this folder when it is present.
/courses/

# Scratch from this build: server logs, one-off probes, and a few third-party files of
# unknown origin. Nothing here is part of the site.
logs/

# PyInstaller output — 89 MB per build, regenerable with packaging/build-sample.ps1.
# It also holds the sealed provider keys, which must never reach git:
# a public repo gets those keys flagged by secret scanning and revoked by the provider.
build/
dist/

# Generated by packaging/keys_embed.py from the .env: it holds live keys in the clear, because the
# build that carries it is the one shared by hand. Never stage it.
packaging/embedded_keys.py

# Run logs.
*.log

# The static site the Django rebuild replaced. Kept on disk for reference, shipped nowhere:
# `chat/chat bot.py` is where the leaked key in the git history lives.
/chat/
/index.html
/qa.html
/academy.html
